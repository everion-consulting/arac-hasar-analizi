# Nginx configuration for hasar.everionai.com
# Copy this file to /etc/nginx/sites-available/hasar.everionai.com
# Then create symlink: sudo ln -s /etc/nginx/sites-available/hasar.everionai.com /etc/nginx/sites-enabled/
# Test: sudo nginx -t
# Restart: sudo systemctl restart nginx

server {
    listen 80;
    # Domain veya IP ile erişim (IP: 31.210.67.67)
    server_name hasar.everionai.com 31.210.67.67;

    # Django Statik Dosyalar (admin CSS/JS ve frontend build dosyaları)
    location /static/ {
        alias /home/yzhasartahmin/arac-hasar-analizi/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    # Backend API ve Auth endpoints (öncelikli - önce bunlar kontrol edilsin)
    location ~ ^/(api|auth|predict|admin)/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Ana giriş - Frontend build edilmişse static'ten, yoksa Django'dan serve et
    # NOT: Frontend build edilmediyse Django'ya yönlendir (Django frontend'i serve edecek)
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
